<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/usersetting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F1B"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="עדכון פרטי פרופיל"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Image -->
        <FrameLayout
            android:id="@+id/flProfileImageContainer"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivProfileImageE"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:src="@drawable/personimeg"
                android:scaleType="centerCrop"
                app:strokeColor="#D36FE4"
                app:strokeWidth="3dp"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:background="#2D1B2E" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddPhotoE"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:src="@android:drawable/ic_menu_camera"
                app:fabCustomSize="36dp"
                app:backgroundTint="#D36FE4"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Full Name -->
        <TextView
            android:id="@+id/tvNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="שם מלא"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/flProfileImageContainer" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEFullName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvNameLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEFullName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="הזינו את שמכם המלא"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAlignment="viewStart"
                android:drawableStart="@drawable/personimeg"
                android:drawablePadding="12dp"
                android:paddingStart="44dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email (Read Only + Helper Text) -->
        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="אימייל"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tilEFullName" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:helperText="לא ניתן לשנות אימייל המקושר לחשבון"
            app:helperTextTextColor="#999999"
            app:layout_constraintTop_toBottomOf="@id/tvEmailLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEEmail"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textEmailAddress"
                android:hint="israel@email.com"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAlignment="viewStart"
                android:drawableStart="@drawable/email"
                android:drawablePadding="12dp"
                android:paddingStart="44dp"
                android:paddingEnd="20dp"
                android:background="@null"
                android:focusable="false"
                android:clickable="false"
                android:cursorVisible="false"
                android:alpha="0.7" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone Number -->
        <TextView
            android:id="@+id/tvPhoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="מספר טלפון"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tilEEmail" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="phone"
                android:hint="הזינו מספר טלפון"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textAlignment="viewStart"
                android:drawableStart="@android:drawable/ic_menu_call"
                android:drawablePadding="12dp"
                android:paddingStart="44dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Section -->
        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="סיסמה חדשה (השאר ריק אם אין שינוי)"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tilEPhone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#999999"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textPassword"
                android:hint="הזן סיסמה חדשה"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical|start"
                android:textAlignment="viewStart"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="12dp"
                android:paddingStart="44dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password Section -->
        <TextView
            android:id="@+id/tvConfirmPasswordLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="אימות סיסמה חדשה"
            android:textColor="#CCCCCC"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tilEPassword" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxStrokeWidth="0dp"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="#999999"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmPasswordLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textPassword"
                android:hint="הזן את הסיסמה שוב"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical|start"
                android:textAlignment="viewStart"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="12dp"
                android:paddingStart="44dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:text="עדכון פרטים"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#D36FE4"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/tilEConfirmPassword"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>