<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F1B"
    android:id="@+id/partySearch"
    android:layoutDirection="rtl">

    <!-- Top Bar with Profile Icon and Glow -->
    <View
        android:id="@+id/profileGlow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/circle"
        android:backgroundTint="#2D1B2E"
        android:alpha="0.5"
        app:layout_constraintBottom_toBottomOf="@id/pageTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/pageTitle" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardBackgroundColor="#2D1B2E"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/profileGlow"
        app:layout_constraintEnd_toEndOf="@id/profileGlow"
        app:layout_constraintStart_toStartOf="@id/profileGlow"
        app:layout_constraintTop_toTopOf="@id/profileGlow">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/personimeg"
            app:tint="#D36FE4" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="חיפוש מסיבה"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pageTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Main Search Container -->
            <LinearLayout
                android:id="@+id/searchForContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input_background"
                android:backgroundTint="#241625"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Fields Container -->
                <LinearLayout
                    android:id="@+id/fieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Location Field -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="מיקום"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="start" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="#2D1B2E"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxStrokeWidth="0dp">

                        <AutoCompleteTextView
                            android:id="@+id/inputLocation"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="בחר איזור"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66FFFFFF"
                            android:textSize="14sp"
                            android:gravity="center_vertical|start"
                            android:textAlignment="viewStart"
                            android:drawableStart="@drawable/locationicon"
                            android:drawablePadding="12dp"
                            android:paddingStart="44dp"
                            android:paddingEnd="20dp"
                            android:background="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Date Field -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="תאריך"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="start" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="#2D1B2E"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxStrokeWidth="0dp">

                        <EditText
                            android:id="@+id/inputDate"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="בחר תאריך"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66FFFFFF"
                            android:textSize="14sp"
                            android:focusable="false"
                            android:gravity="center_vertical|start"
                            android:textAlignment="viewStart"
                            android:drawableStart="@drawable/date_icon"
                            android:drawablePadding="12dp"
                            android:paddingStart="44dp"
                            android:paddingEnd="20dp"
                            android:background="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Time Field -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="שעת התחלה"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="start" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="#2D1B2E"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxStrokeWidth="0dp">

                        <EditText
                            android:id="@+id/inputTime"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="בחר שעה"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66FFFFFF"
                            android:textSize="14sp"
                            android:focusable="false"
                            android:gravity="center_vertical|start"
                            android:textAlignment="viewStart"
                            android:drawableStart="@drawable/time_icon"
                            android:drawablePadding="12dp"
                            android:paddingStart="44dp"
                            android:paddingEnd="20dp"
                            android:background="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Age Range Field -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="טווח גילאים"
                        android:textColor="#CCCCCC"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="start" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="#2D1B2E"
                        app:boxBackgroundMode="filled"
                        app:boxCornerRadiusBottomEnd="28dp"
                        app:boxCornerRadiusBottomStart="28dp"
                        app:boxCornerRadiusTopEnd="28dp"
                        app:boxCornerRadiusTopStart="28dp"
                        app:boxStrokeWidth="0dp">

                        <AutoCompleteTextView
                            android:id="@+id/inputAge"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="בחר טווח גילאים"
                            android:textColor="#FFFFFF"
                            android:textColorHint="#66FFFFFF"
                            android:textSize="14sp"
                            android:gravity="center_vertical|start"
                            android:textAlignment="viewStart"
                            android:drawableStart="@drawable/groups_icon"
                            android:drawablePadding="12dp"
                            android:paddingStart="44dp"
                            android:paddingEnd="20dp"
                            android:background="@null" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- FrameLayout for Fragment Results -->
                <FrameLayout
                    android:id="@+id/resultsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:text="חיפוש מסיבה"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:background="@drawable/button_gradient"
                app:backgroundTint="@null"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
