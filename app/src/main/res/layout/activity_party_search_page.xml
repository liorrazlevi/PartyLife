<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F1B"
    android:id="@+id/partySearch"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/pageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="חיפוש מסיבה"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.cardview.widget.CardView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="24dp"
        app:cardBackgroundColor="#333333"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="@id/pageTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/pageTitle">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/personimeg"
            app:tint="#CCCCCC" />
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pageTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_outline"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="right"
                    android:text="מיקום"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp" />

                <AutoCompleteTextView
                    android:id="@+id/inputLocation"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/button_outline"
                    android:drawableStart="@drawable/locationicon"
                    android:drawablePadding="12dp"
                    android:drawableTint="#999999"
                    android:gravity="center_vertical|right"
                    android:inputType="none"
                    android:hint="בחר איזור"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="right"
                    android:text="תאריך"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputDate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/button_outline"
                    android:drawableStart="@drawable/date_icon"
                    android:drawablePadding="12dp"
                    android:drawableTint="#999999"
                    android:focusable="false"
                    android:textStyle="bold"
                    android:gravity="center_vertical|right"
                    android:hint="בחר תאריך"
                    android:inputType="date"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="right"
                    android:text="שעת התחלה"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputTime"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/button_outline"
                    android:drawableStart="@drawable/time_icon"
                    android:drawablePadding="12dp"
                    android:drawableTint="#999999"
                    android:focusable="false"
                    android:textStyle="bold"
                    android:gravity="center_vertical|right"
                    android:hint="בחר שעה"
                    android:inputType="time"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="right"
                    android:text="טווח גילאים"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputAge"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/button_outline"
                    android:drawableStart="@drawable/groups_icon"
                    android:drawablePadding="12dp"
                    android:textStyle="bold"
                    android:drawableTint="#999999"
                    android:gravity="center_vertical|right"
                    android:hint="לדוגמה: 18-25"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#66FFFFFF"
                    android:textSize="14sp" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSearch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/button_gradient"
                android:text="חיפוש"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>