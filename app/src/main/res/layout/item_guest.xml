<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="#1A0F1B">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivGuestProfile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:src="@drawable/personimeg"
        android:background="#3D2B3E"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:tint="#FFFFFF" />

    <!-- תגית סטטוס (כן/לא) - הכי שמאלית -->
    <TextView
        android:id="@+id/statusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="כן"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_status_green"
        tools:background="@drawable/bg_status_red"
        tools:text="לא"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- שם האורח - באמצע, מיושר לימין ליד התמונה -->
    <TextView
        android:id="@+id/tvGuestName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginLeft="12dp"
        android:text="שם האורח"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/statusBadge"
        app:layout_constraintRight_toLeftOf="@id/ivGuestProfile"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- קו מפריד דק בתחתית -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/ivGuestProfile"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>