<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="#1A0F1B"
    android:layoutDirection="rtl">



    <!-- תמונת הפרופיל של האורח - גדולה וברורה -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivGuestIcon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:padding="2dp"
        android:src="@drawable/personimeg"
        android:scaleType="centerCrop"
        app:strokeColor="#D36FE4"
        app:strokeWidth="2dp"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- תגית הסטטוס (צד שמאל) - דינמית -->
    <TextView
        android:id="@+id/tvGuestStatus"
        android:layout_width="45dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/bg_status_green"
        android:text="כן"
        tools:background="@drawable/bg_status_red"
        tools:text="לא"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- שם האורח (באמצע) -->
    <TextView
        android:id="@+id/tvGuestName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginRight="12dp"
        android:layout_marginLeft="20dp"
        android:text="ישראל ישראלי"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/tvGuestStatus"
        app:layout_constraintRight_toLeftOf="@id/ivGuestIcon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- קו מפריד תחתון -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="12dp"
        android:background="#22FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/ivGuestIcon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>