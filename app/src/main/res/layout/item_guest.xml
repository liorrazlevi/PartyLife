<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="#1A0F1B">

    <!-- תמונת פרופיל עגולה -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivGuestProfile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/CircleImage" />

    <!-- שם האורח -->
    <TextView
        android:id="@+id/tvGuestName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="שם האורח"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="right"
        app:layout_constraintBottom_toBottomOf="@id/ivGuestProfile"
        app:layout_constraintEnd_toStartOf="@id/ivGuestProfile"
        app:layout_constraintStart_toEndOf="@id/statusBadge"
        app:layout_constraintTop_toTopOf="@id/ivGuestProfile" />

    <!-- תגית סטטוס (כן / לא) -->
    <TextView
        android:id="@+id/statusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text="כן"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:background="@drawable/bg_status_green"
        xmlns:tools="http://schemas.android.com/tools"
        tools:text="לא"
        tools:background="@drawable/bg_status_red"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- קו מפריד דק -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/ivGuestProfile" />

</androidx.constraintlayout.widget.ConstraintLayout>