<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F1B"
    android:fillViewport="true"
    android:id="@+id/partyEdit"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <!-- Title Section -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="עריכת מסיבה"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Location Field -->
        <TextView
            android:id="@+id/tvLocationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="מיקום (GPS)"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvLocationLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="דיזנגוף 99, תל אביב"
                app:hintEnabled="false"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical|start"
                android:drawableStart="@drawable/locationicon"
                android:drawablePadding="12dp"
                android:drawableTint="#999999"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date and Time Row -->
        <LinearLayout
            android:id="@+id/rowDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tilLocation">

            <!-- Date Field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="תאריך"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#2D1B2E"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="08/15/2024"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColorHint="#66FFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center_vertical|start"
                        android:drawableStart="@drawable/date_icon"
                        android:drawablePadding="12dp"
                        android:drawableTint="#999999"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Time Field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="שעת התחלה"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#2D1B2E"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTime"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="10:00 PM"
                        android:focusable="false"
                        android:clickable="true"
                        android:textColorHint="#66FFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center_vertical|start"
                        android:textAlignment="viewStart"
                        android:drawableStart="@drawable/time_icon"
                        android:drawablePadding="12dp"
                        android:drawableTint="#999999"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Minimum Age Field (עם AutoCompleteTextView אבל בלי החץ) -->
        <TextView
            android:id="@+id/tvAgeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="טווח גילאים"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/rowDateTime" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvAgeLabel">

            <AutoCompleteTextView
                android:id="@+id/inputAge"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="18+"
                android:inputType="none"
                android:textColor="#FFFFFF"
                android:textColorHint="#66FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical|start"
                android:textAlignment="viewStart"
                android:drawableStart="@drawable/groups_icon"
                android:drawablePadding="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Parking Details Field -->
        <TextView
            android:id="@+id/tvParkingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="פרטי חניה"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/tilAge" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilParking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvParkingLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etParking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="חניון גורדון בתשלום"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical|start"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dress Code Field -->
        <TextView
            android:id="@+id/tvDressCodeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="קוד לבוש"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/tilParking" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDressCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvDressCodeLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDressCodeEdit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="קז'ואל-אלגנט"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical|start"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Organizer Phone Field (מיושר לימין) -->
        <TextView
            android:id="@+id/tvPhoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="טלפון מארגן"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/tilDressCode" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint= "054-1234567"
                android:inputType="phone"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="start|center_vertical"
                android:textDirection="rtl"
                android:drawableStart="@android:drawable/ic_menu_call"
                android:drawablePadding="12dp"
                android:textAlignment="viewStart"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:text="שמור שינויים"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#EE2B9C"
            app:cornerRadius="28dp"
            app:layout_constraintTop_toBottomOf="@id/tilPhone" />

        <!-- View Events Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewEvents"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="צפייה באירועי הגעה"
            android:textColor="#EE2B9C"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@android:color/transparent"
            app:strokeColor="#EE2B9C"
            app:strokeWidth="2dp"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSaveChanges" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>