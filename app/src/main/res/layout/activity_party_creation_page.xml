<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A0F1B"
    android:fillViewport="true"
    android:id="@+id/partycreation"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:layoutDirection="rtl">

        <!-- Profile Icon (User's Profile) -->
        <View
            android:id="@+id/profileGlow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/circle"
            android:backgroundTint="#2D1B2E"
            android:alpha="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivProfile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/personimeg"
            app:tint="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="@id/profileGlow"
            app:layout_constraintEnd_toEndOf="@id/profileGlow"
            app:layout_constraintStart_toStartOf="@id/profileGlow"
            app:layout_constraintTop_toTopOf="@id/profileGlow" />

        <!-- Title Section -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="יצירת מסיבה"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="מלא את הפרטים ליצירת המסיבה שלך"
            android:textColor="#9575CD"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <!-- Small & Elegant Party Image Upload -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPartyImage"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#2D1B2E"
            app:cardCornerRadius="28dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#3D2B3E"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/ivSelectedPartyImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/partyicon"
                    />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivUploadImage"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#D36FE4" />

                    <TextView
                        android:id="@+id/tvUploadImage"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="תמונת מסיבה"
                        android:textColor="#D36FE4"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Fields Section -->
        <TextView
            android:id="@+id/tvNameLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="שם המסיבה"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/cvPartyImage" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPartyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvNameLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPartyName"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="לדוגמה: מסיבת הקיץ הגדולה"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Location Field -->
        <TextView
            android:id="@+id/tvLocationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="מיקום"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/tilPartyName" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvLocationLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="הזן כתובת או שם המקום"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/locationicon"
                android:drawablePadding="12dp"
                android:drawableTint="#999999"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date and Time Row (Combined) -->
        <LinearLayout
            android:id="@+id/rowDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tilLocation">

            <!-- Date Field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="תאריך"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#2D1B2E"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDate"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="בחר תאריך"
                        android:focusable="false"
                        android:textColorHint="#66FFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center_vertical"
                        android:drawableStart="@drawable/date_icon"
                        android:drawablePadding="12dp"
                        android:drawableTint="#999999"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Time Field -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="שעת התחלה"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#2D1B2E"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTime"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="בחר שעה"
                        android:focusable="false"
                        android:textColorHint="#66FFFFFF"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center_vertical"
                        android:drawableStart="@drawable/time_icon"
                        android:drawablePadding="12dp"
                        android:drawableTint="#999999"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Row (Age & Dress Code) -->
        <LinearLayout
            android:id="@+id/rowBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/rowDateTime">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="גיל"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#2D1B2E"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp">

                    <AutoCompleteTextView
                        android:id="@+id/etAge"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="בחר"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#66FFFFFF"
                        android:textSize="14sp"
                        android:gravity="center"
                        android:padding="0dp"
                        android:inputType="none"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="קוד לבוש"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:hintEnabled="false"
                    app:boxBackgroundColor="#2D1B2E"
                    app:boxBackgroundMode="filled"
                    app:boxCornerRadiusBottomEnd="28dp"
                    app:boxCornerRadiusBottomStart="28dp"
                    app:boxCornerRadiusTopEnd="28dp"
                    app:boxCornerRadiusTopStart="28dp"
                    app:boxStrokeWidth="0dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDressCode"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="לדוגמה: אלגנט"
                        android:textColor="#FFFFFF"
                        android:paddingStart="20dp"
                        android:background="@null" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Parking Field -->
        <TextView
            android:id="@+id/tvParkingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="מיקום חנייה קרובה"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/rowBottom" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilParking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvParkingLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etParking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="לדוגמה: חניון המרכז, רחוב הברזל 1"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@null" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone Number Field -->
        <TextView
            android:id="@+id/tvPhoneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="טלפון ליצירת קשר"
            android:textColor="#CCCCCC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="start"
            app:layout_constraintTop_toBottomOf="@id/tilParking" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:hintEnabled="false"
            app:boxBackgroundColor="#2D1B2E"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneLabel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="הקלד מספר טלפון"
                android:inputType="phone"
                android:textColorHint="#66FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="start|center_vertical"
                android:textDirection="rtl"
                android:textAlignment="viewStart"
                android:drawableStart="@android:drawable/ic_menu_call"
                android:drawablePadding="12dp"
                android:drawableTint="#999999"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@null" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Create Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="24dp"
            android:text="צור מסיבה"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/button_gradient"
            app:backgroundTint="@null"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tilPhone" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
